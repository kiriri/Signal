{
  "name": "native-signal",
  "version": "0.5.4",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "Similar to Angular's Signal system, but framework independent, fast, and with some planned collection support.",
  "scripts": {
    "publish:local": "npm run build:mangled && npx yalc push --private",
    "test": "tsx --expose-gc ./src/Tests/NewTest.ts",
    "test:stress": "tsx --expose-gc ./src/Tests/StressTest2.ts",
    "build": "rm ./dist -rf && rollup --config rollup.config.ts"
  },
  "exports": {
    "./*": "./dist/*.js",
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiriri/Signal.git"
  },
  "keywords": [
    "signal"
  ],
  "author": "Sven Hollesen",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/kiriri/Signal/issues"
  },
  "homepage": "https://github.com/kiriri/Signal#readme",
  "devDependencies": {
    "@ampproject/rollup-plugin-closure-compiler": "^0.27.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "jsmin": "^1.0.1",
    "rollup": "^4.45.1",
    "rollup-plugin-terser": "^7.0.2",
    "ts-morph": "^26.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "uglify-es": "^3.3.10",
    "rollup-plugin-uglify": "^6.0.4"
  },
  "dependencies": {
  }
}
