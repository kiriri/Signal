{
  "name": "native-signal",
  "version": "0.5.7",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "Similar to Angular's Signal system, but framework independent, fast, and with some planned collection support.",
  "scripts": {
    "publish:local": "npm run build:mangled && npx yalc push --private",
    "test": "tsx --expose-gc ./src/Tests/NewTest.ts",
    "test:stress": "tsx --expose-gc ./src/Tests/StressTest2.ts",
    "test:angular": "node ./dist/strong/Tests/Benchmark.js",
    "build": "rm ./dist -rf && rollup --config rollup.config.ts"
  },
  "exports": {
    "./weak": {
      "require": "./dist/weak/index.js",
      "import": "./dist/weak/index.js",
      "types": "./dist/weak/index.d.ts"
    },
    "./strong": {
      "require": "./dist/strong/index.js",
      "import": "./dist/strong/index.js",
      "types": "./dist/strong/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiriri/Signal.git"
  },
  "keywords": [
    "signal"
  ],
  "author": "Sven Hollesen",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/kiriri/Signal/issues"
  },
  "homepage": "https://github.com/kiriri/Signal#readme",
  "devDependencies": {
    "@ampproject/rollup-plugin-closure-compiler": "^0.27.0",
    "@angular/core": "^21.2.11",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "jsmin": "^1.0.1",
    "reflect-metadata": "^0.2.2",
    "rollup": "^4.45.1",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-uglify": "^6.0.4",
    "solid-js": "^1.9.12",
    "ts-morph": "^26.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "uglify-es": "^3.3.10"
  }
}
