{
  "name": "native-signal",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "Similar to Angular's Signal system, but framework independent, fast, and with some collection support.",
  "scripts": {
    "test": "tsx --expose-gc ./src/Tests/NewTest.ts & tsx --expose-gc ./src/Tests/StressTest2.ts",
    "build": "rm ./dist -r && npx tsc",
    "build:lite": "npx tsc",
    "build:alt": "npx tsc ./src/index.ts --outDir ./dist --noCheck --sourceMap --declaration --declarationMap"
  },
  "exports": {
    "./*": "./dist/*.js",
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiriri/Signal.git"
  },
  "keywords": [
    "signal"
  ],
  "author": "Sven Hollesen",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/kiriri/Signal/issues"
  },
  "homepage": "https://github.com/kiriri/Signal#readme",
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
