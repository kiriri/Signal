{
    "compilerOptions": {
      "baseUrl": "./",
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "sourceMap": true,
      "forceConsistentCasingInFileNames": true,
      "strict": false,
      "skipLibCheck": true, // Don't fail if a typescript error happens at compile time
      "esModuleInterop": true,
      "moduleResolution": "node",
      "lib": ["ESNext", "ES2021.WeakRef"],
      "isolatedModules": false,
      "module": "ESNext",
      "target": "ESNext"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules","src/**/*.test.ts"],
  }